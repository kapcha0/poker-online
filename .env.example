# Скопируйте в .env и подставьте свои значения.
# Файл .env в git не попадает (см. .gitignore).

# База данных (локальный Docker)
DATABASE_URL=postgres://poker:poker_dev_password@localhost:5432/poker_dev

# Кэш / сессии (локальный Docker)
REDIS_URL=redis://localhost:6379/0

# Секрет подписи токенов (сменить перед релизом!)
JWT_SECRET=change-me-in-production

# Порт игрового сервера
PORT=3000

# Окружение
NODE_ENV=development
