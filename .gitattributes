# Normalize line endings: store LF in the repo, checkout native per OS.
* text=auto eol=lf

# Unity binary assets - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.unity binary
*.asset binary
*.prefab binary
*.fbx binary
*.dll binary
*.so binary
*.aar binary
*.jar binary

# Unity text assets should use LF
*.cs text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
